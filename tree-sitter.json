{
  "grammars": [
    {
      "name": "snowflake",
      "camelcase": "Snowflake",
      "scope": "source.snowflake",
      "path": ".",
      "file-types": [
        "sql"
      ],
      "highlights": [
        "queries/highlights.scm"
      ],
      "injections": [
        "queries/injections.scm"
      ],
      "locals": [
        "queries/locals.scm"
      ],
      "tags": [
        "queries/tags.scm"
      ]
    }
  ],
  "metadata": {
    "version": "0.2.2",
    "license": "MIT",
    "description": "Tree-sitter grammar for Snowflake SQL",
    "authors": [
      {
        "name": "M. Reifschneider"
      }
    ],
    "links": {
      "repository": "git+https://github.com/alfpricot/tree-sitter-snowflake.git"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": true,
    "python": false,
    "rust": true,
    "swift": false
  }
}
